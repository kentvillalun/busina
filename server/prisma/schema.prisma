generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Direction {
  NORTHBOUND
  SOUTHBOUND
}

enum Role {
  DRIVER
  CONDUCTOR
  OPERATOR
}

// Set by the driver. AT_REST: off duty, hidden from commuters. STOPOVER: a short stop, shown as stopped with no ETA.
enum ServiceStatus {
  IN_SERVICE
  AT_REST
  STOPOVER
}

model Company {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name      String  @unique
  shortName String?
  logoUrl   String?

  createdAt DateTime @default(now())

  users  User[]
  routes Route[]
  buses  Bus[]
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  role Role

  firstName String
  lastName  String
  // Operators sign in with these two. A driver or conductor on the staff roster is a record only: no username, no password.
  username     String? @unique
  passwordHash String?

  // The bus a driver or conductor works on (the roster); null for an operator or for staff without a bus yet.
  busId String? @db.Uuid
  bus   Bus?    @relation(fields: [busId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([busId])
}

model Route {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name     String
  // Points are [lng, lat], ordered from the first terminal to the last. `polyline` is the road southbound buses take.
  polyline Json
  // The road northbound buses take, when it differs (Vigan City Diversion Road). Same point order, own length.
  polylineNorthbound Json?
  lengthM  Int

  createdAt DateTime @default(now())

  buses Bus[]

  @@unique([companyId, name])
}

model Bus {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  routeId String @db.Uuid
  route   Route  @relation(fields: [routeId], references: [id])

  busNumber     String
  plateNumber   String  @unique
  name          String?
  photoUrl      String?
  seatCount     Int     @default(40)
  deviceId      String  @unique
  deviceKeyHash String
  // Driver sign-in PIN (bcrypt); null until `npm run bus:pin` sets one, and then nobody can sign in as this bus.
  pinHash       String?
  active        Boolean @default(true)
  // Lives on Bus, not BusState: a ping upserts BusState every few seconds and must never undo what the driver chose.
  serviceStatus ServiceStatus @default(IN_SERVICE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state BusState?
  staff User[]

  @@unique([companyId, busNumber])
  @@index([routeId])
}

model BusState {
  busId String @id @db.Uuid
  bus   Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)

  lat Float
  lng Float

  speedMps     Float
  seats        Int[]
  occupied     Int
  doorInTotal  Int   @default(0)
  doorOutTotal Int   @default(0)

  direction Direction?

  lastPingAt DateTime
  updatedAt  DateTime @updatedAt
}

// One row per browser that turned on alerts. It belongs to the signed-in commuter; logging out on that browser, or deleting the account, removes it.
model PushSubscription {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  commuterId String   @db.Uuid
  commuter   Commuter @relation(fields: [commuterId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  spotLat      Float
  spotLng      Float
  alertMinutes Int

  direction Direction
  // The bus chosen on its detail page; null = any bus going `direction`. Not a foreign key: a deleted bus simply never matches.
  targetBusId String? @db.Uuid
  // Ids of the buses already alerted in this approach, so one bus alerts once (see push.js).
  notifiedBusIds Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commuterId])
}

// A person who signed in with Google. Google proves the email, so there is no password and no OTP.
model Commuter {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  googleId String @unique
  email    String @unique
  name     String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pushSubscriptions PushSubscription[]
  waitingSpot       WaitingSpot?
}

// "I'm waiting here": a commuter who agreed to let drivers see an anonymous marker where they wait. One row per commuter. It
// expires by itself (expiresAt), and is deleted when they stop sharing or sign out. Separate from PushSubscription on purpose:
// sharing works without notifications, and the alert spots are never shown to drivers.
model WaitingSpot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  commuterId String   @unique @db.Uuid
  commuter   Commuter @relation(fields: [commuterId], references: [id], onDelete: Cascade)

  lat       Float
  lng       Float
  direction Direction

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Tokens that were logged out before they expired. Only the SHA-256 hash is stored, so a leaked table cannot be used as sessions.
// Rows are useless after expiresAt and are deleted on every logout.
model BlacklistedToken {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
}
